{
  "name": "solar-monitoring",
  "version": "0.0.0",
  "description": "epic solar frontend",
  "scripts": {
    "dev": "parcel src/index.html",
    "image-server": "node server.js",
    "build": "parcel build src/index.html && cp favicon.ico dist/favicon.ico",
    "build-local": "parcel build src/index.html --dist-dir ../backend/src/main/resources/static",
    "format": "prettier --write \"**/*.*(js|ts|jsx|tsx)\"",
    "build-dev": "NODE_ENV=development parcel build --no-optimize src/index.html"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@date-io/moment": "^2.17.0",
    "@material-ui/icons": "^4.11.3",
    "@mui/icons-material": "^5.17.1",
    "@mui/lab": "5.0.0-alpha.135",
    "@mui/material": "^5.17.1",
    "@mui/x-date-pickers": "6.9.2",
    "@types/recharts": "^1.8.29",
    "history": "^5.3.0",
    "jwt-decode": "^3.1.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "node-sass": "^9.0.0",
    "parcel": "^2.14.4",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^6.30.0",
    "react-toastify": "^9.1.3",
    "recharts": "^2.15.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
