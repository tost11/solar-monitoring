    "@emotion/styled": "^11.14.0",
    "@parcel/transformer-raw": "^2.9.3",
    "@parcel/transformer-typescript-tsc": "^2.14.4",
    "@types/react": "^17.0.85",
    "@types/react-dom": "^17.0.26",
    "http-proxy-middleware": "^2.0.7",
    "prettier": "^3.5.3",
    "process": "^0.11.10",
    "typescript": "^5.8.2"
  }
